# ════════════════════════════════════════════════════════════════════════
# Inceptrax Backend — Environment Variables
# ════════════════════════════════════════════════════════════════════════
# Copy this file to .env (or .env.local) and fill in your values.
# NEVER commit .env files to git. Use Doppler for production secrets.
# ════════════════════════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────────────────
APP_ENV=development                    # development | production
SECRET_KEY=                            # Flask secret key (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=                        # JWT signing key (can differ from SECRET_KEY)
JWT_REFRESH_SECRET_KEY=                # JWT refresh token signing key
JWT_ACCESS_EXPIRES=7                   # Access token expiry in days
JWT_REFRESH_EXPIRES=30                 # Refresh token expiry in days

# ─── Database ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/inceptrax   # MongoDB Atlas connection string
MONGODB_DB_NAME=inceptrax              # Database name (extracted from URI if not set)

# ─── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=Inceptrax921@gmail.com     # Primary admin account email

# ─── AI Providers ──────────────────────────────────────────────────────
GEMINI_API_KEY=                        # Google AI Studio API key
GEMINI_MODEL=gemini-2.5-flash         # Default Gemini model
GROQ_API_KEY=                          # Groq API key (fallback)
OPENROUTER_API_KEY=                    # OpenRouter API key (fallback)

# ─── Search ────────────────────────────────────────────────────────────
SERPAPI_KEY=                           # SerpAPI key (Phase 1, will be replaced by Serper in Phase 2)

# ─── Email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                        # Resend API key (primary email provider)
MAIL_USERNAME=                         # Gmail address (SMTP fallback sender)
MAIL_PASSWORD=                         # Gmail app password (SMTP fallback)

# ─── Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000     # Frontend URL for CORS and email links

# ─── Observability ─────────────────────────────────────────────────────
SENTRY_DSN=                            # Sentry DSN for backend error tracking (leave empty to disable)
