# ════════════════════════════════════════════════════════════════════════
# Inceptrax Backend — Environment Variables
# ════════════════════════════════════════════════════════════════════════
# Copy this file to .env (or .env.local) and fill in your values.
# NEVER commit .env files to git. Use Doppler for production secrets.
# ════════════════════════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────────────────
APP_ENV=development                    # development | production
SECRET_KEY=                            # Flask secret key (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=                        # JWT signing key (can differ from SECRET_KEY)
JWT_REFRESH_SECRET_KEY=                # JWT refresh token signing key
JWT_ACCESS_EXPIRES=7                   # Access token expiry in days
JWT_REFRESH_EXPIRES=30                 # Refresh token expiry in days

# ─── Database ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/inceptrax   # MongoDB Atlas connection string
MONGODB_DB_NAME=inceptrax              # Database name (extracted from URI if not set)

# ─── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=Inceptrax921@gmail.com     # Primary admin account email

# ─── AI Providers ──────────────────────────────────────────────────────
GEMINI_API_KEY=                        # Google AI Studio API key
GEMINI_MODEL=gemini-2.5-flash         # Default Gemini model
GROQ_API_KEY=                          # Groq API key (fallback)
OPENROUTER_API_KEY=                    # OpenRouter API key (fallback)

# ─── Search ────────────────────────────────────────────────────────────
SERPAPI_KEY=                           # SerpAPI key (Phase 1, will be replaced by Serper in Phase 2)

# ─── Email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                        # Resend API key (primary email provider)
MAIL_USERNAME=                         # Gmail address (SMTP fallback sender)
MAIL_PASSWORD=                         # Gmail app password (SMTP fallback)

# ─── Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000     # Frontend URL for CORS and email links

# ─── Observability ─────────────────────────────────────────────────────
SENTRY_DSN=                            # Sentry DSN for backend error tracking (leave empty to disable)

# ─── LemonSqueezy ──────────────────────────────────────────────────────────
# Test mode and live mode are entirely separate environments with their own
# products, customers and IDs. Every setting is read mode-first and then falls
# back to the unprefixed name, so switching environments is a one-line change:
#
#   LEMONSQUEEZY_MODE=test  -> uses LEMONSQUEEZY_TEST_*  (falls back to plain)
#   LEMONSQUEEZY_MODE=live  -> uses LEMONSQUEEZY_LIVE_*  (falls back to plain)
#
# Recommended: keep MODE=test locally and MODE=live in production.
LEMONSQUEEZY_MODE=live

# ── Live (production) ──
LEMONSQUEEZY_LIVE_API_KEY=
LEMONSQUEEZY_LIVE_STORE_ID=
LEMONSQUEEZY_LIVE_STARTER_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_LIVE_STARTER_YEARLY_VARIANT_ID=
LEMONSQUEEZY_LIVE_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_LIVE_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_LIVE_ENTERPRISE_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_LIVE_ENTERPRISE_YEARLY_VARIANT_ID=

# ── Test (development sandbox) ──
LEMONSQUEEZY_TEST_API_KEY=
LEMONSQUEEZY_TEST_STORE_ID=
LEMONSQUEEZY_TEST_STARTER_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_TEST_STARTER_YEARLY_VARIANT_ID=
LEMONSQUEEZY_TEST_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_TEST_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_TEST_ENTERPRISE_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_TEST_ENTERPRISE_YEARLY_VARIANT_ID=

# Webhook signing secret — set the SAME value in the LemonSqueezy dashboard.
# Each mode has its own webhook endpoint, so each can have its own secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_WEBHOOK_SECRET=

# Verified sender for Resend. Until a domain is verified, Resend only allows
# sending to your own address — set this to noreply@yourdomain once verified.
EMAIL_FROM=Inceptrax <noreply@inceptrax.com>
