# ════════════════════════════════════════════════════════════════════════
# Inceptrax Frontend — Environment Variables
# ════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — be careful.
# ════════════════════════════════════════════════════════════════════════

# ─── API ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api   # Backend API base URL

# ─── Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=               # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # PostHog host

# ─── Observability ─────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                # Sentry DSN for frontend error tracking (leave empty to disable)
